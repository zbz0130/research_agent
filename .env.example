WISHFORGE_APP_NAME=许愿机 API
WISHFORGE_BRAND_NAME=许愿机
WISHFORGE_BRAND_NAME_EN=WishForge
WISHFORGE_VERSION=0.2.3
WISHFORGE_CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Provider selection and purpose-specific credentials.
WISHFORGE_PAPER_PROVIDER=multi_source
WISHFORGE_PAPER_BASE_URL=
WISHFORGE_PAPER_MODEL=
WISHFORGE_PAPER_ENABLED=true
WISHFORGE_COMMUNITY_PROVIDER=hacker_news
WISHFORGE_COMMUNITY_BASE_URL=https://hacker-news.firebaseio.com/v0
WISHFORGE_COMMUNITY_MODEL=
WISHFORGE_COMMUNITY_ENABLED=true
WISHFORGE_EXPLANATION_PROVIDER=openai
WISHFORGE_EXPLANATION_ENABLED=true
WISHFORGE_EXPERIMENT_PROVIDER=local
WISHFORGE_EXPERIMENT_BASE_URL=
WISHFORGE_EXPERIMENT_MODEL=
WISHFORGE_EXPERIMENT_ENABLED=false
WISHFORGE_EXPLANATION_MODEL=gpt-4.1-mini
WISHFORGE_EXPLANATION_BASE_URL=https://api.openai.com/v1
WISHFORGE_EXPLANATION_TIMEOUT_SECONDS=90
WISHFORGE_DEMO_MODE=false
WISHFORGE_STORAGE_PATH=data/wishforge.db
WISHFORGE_PAPER_API_KEY=
WISHFORGE_COMMUNITY_API_KEY=
WISHFORGE_EXPLANATION_API_KEY=
WISHFORGE_EXPERIMENT_API_KEY=
