{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WishForge",
  "version": "0.2.0",
  "identifier": "com.wishforge.research",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm run build && powershell -ExecutionPolicy Bypass -File ../scripts/build-sidecar.ps1",
      "cwd": "../frontend",
      "wait": true
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "许愿机 / WishForge",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["bin/wishforge-sidecar"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
